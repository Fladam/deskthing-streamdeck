{
  "name": "deskthing-streamdeck",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:configurator": "vite build --config configurator/vite.config.ts && node scripts/embed-configurator.mjs",
    "dev": "npm run build:configurator && npx @deskthing/cli dev --vite",
    "dev:vite": "vite",
    "dev:configurator": "vite --config configurator/vite.config.ts",
    "build": "npm run build:configurator && npx @deskthing/cli package",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deskthing/client": "^0.11.2",
    "@deskthing/server": "^0.11.6",
    "autoprefixer": "^10.4.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deskthing/cli": "^0.11.15",
    "@deskthing/types": "^0.11.18",
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.19.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "tailwindcss": "^3.4.10",
    "tsm": "^2.3.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.15",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fladam/deskthing-streamdeck.git"
  },
  "homepage": "https://github.com/Fladam/deskthing-streamdeck"
}
